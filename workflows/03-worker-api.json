    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE upwork_tasks SET status = r.status, finished_at = now(), summary_ru = r.summary_ru, tests = r.tests, folder = r.folder, review_score = r.review_score\nFROM json_to_record($1::json) AS r(id int, status text, summary_ru text, tests text, folder text, review_score int)\nWHERE upwork_tasks.id = r.id;",
        "options": {
          "queryReplacement": "={{ [JSON.stringify({ id: $('FORMAT RESULT').item.json.id, status: $('FORMAT RESULT').item.json.status, summary_ru: $('FORMAT RESULT').item.json.summary_ru, tests: $('FORMAT RESULT').item.json.tests, folder: $('FORMAT RESULT').item.json.folder, review_score: $('FORMAT RESULT').item.json.review_score })] }}"
