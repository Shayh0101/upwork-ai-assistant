      "id": "530e4e83-ba32-44d4-b601-674133b70337",
      "name": "WORKER SENDS RESULT",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        240
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Сообщение «работа окончена» для Telegram (HTML)\nconst esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst b = $json.body || {};\nlet tests = [];\ntry { tests = JSON.parse(b.tests || '[]'); } catch (e) { tests = []; }\nif (!Array.isArray(tests)) tests = [];\nconst passed = tests.filter((t) => t && t.passed).length;\nconst ok = b.status === 'done';\nconst score = Number(b.review_score);\nconst kind = b.is_revision ? 'Доработка' : 'Работа';\nconst lines = [\n  ok ? '✅ <b>' + kind + ' окончена</b> — задача #' + esc(b.id) : '❌ <b>Не получилось</b> — задача #' + esc(b.id),\n  b.title ? '<b>' + esc(b.title) + '</b>' : '',\n  b.summary_ru ? '📝 ' + esc(b.summary_ru) : '',\n  tests.length ? '🧪 <b>Тесты: ' + passed + '/' + tests.length + '</b>\\n' + tests.map((t) => (t.passed ? '✅ ' : '❌ ') + esc(t.name)).join('\\n') : '🧪 Тесты не найдены',\n  Number.isFinite(score) && b.review_score !== '' ? '🔍 <b>Проверка вторым ИИ: ' + score + '/10</b> ' + (score >= 8 ? '🟢' : score >= 6 ? '🟡' : '🔴') + (b.review_ru ? '\\n' + esc(b.review_ru) : '') : '',\n  b.how_to_run_ru ? '▶️ <b>Как запустить:</b>\\n' + esc(b.how_to_run_ru) : '',\n  b.needs_ru ? '🔑 <b>Нужно от клиента:</b> ' + esc(b.needs_ru) : '',\n  b.error ? '⚠️ ' + esc(String(b.error).slice(0, 800)) : '',\n  ok ? '👉 Проверьте проект. Если всё хорошо — отправьте архив клиенту в чате Upwork. Нужны правки — кнопка 🔁 ниже.' : '🔁 Можно нажать «Доработать» и написать, что исправить.',\n];\nconst hasZip = !!($input.item.binary && Object.keys($input.item.binary).length);\nreturn { json: { id: Number(b.id) || null, status: ok ? 'done' : 'failed', summary_ru: b.summary_ru || b.error || '', tests: JSON.stringify(tests), folder: b.folder || '', review_score: Number.isFinite(score) && b.review_score !== '' ? score : null, text: lines.filter(Boolean).join('\\n\\n').slice(0, 4000), has_zip: hasZip, zip_field: hasZip ? Object.keys($input.item.binary)[0] : '' }, binary: $input.item.binary };"
      },
