    {
      "parameters": {
        "operation": "executeQuery",
        "query": "CREATE TABLE IF NOT EXISTS upwork_tasks (\n  id SERIAL PRIMARY KEY,\n  message_id INT,\n  title TEXT,\n  prompt TEXT,\n  status TEXT DEFAULT 'queued',\n  created_at TIMESTAMPTZ DEFAULT now(),\n  started_at TIMESTAMPTZ,\n  finished_at TIMESTAMPTZ,\n  summary_ru TEXT,\n  tests TEXT,\n  folder TEXT\n);\nALTER TABLE upwork_tasks ADD COLUMN IF NOT EXISTS revision_of INT;\nALTER TABLE upwork_tasks ADD COLUMN IF NOT EXISTS review_score INT;",
        "options": {}
      },
      "id": "9eb66def-a624-4c4c-8abc-c802b6335879",
      "name": "ENSURE TASKS TABLE",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        224,
        -80
      ],
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "name": "Postgres"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE upwork_tasks t SET status = 'running', started_at = now()\nWHERE t.id = (SELECT id FROM upwork_tasks WHERE status = 'queued' ORDER BY id LIMIT 1 FOR UPDATE SKIP LOCKED)\nRETURNING t.id, t.title, t.prompt, t.revision_of,\n  (SELECT p.folder FROM upwork_tasks p WHERE p.id = t.revision_of) AS parent_folder;",
        "options": {}
      },
